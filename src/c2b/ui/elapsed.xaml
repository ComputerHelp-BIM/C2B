<?xml version="1.0" encoding="utf-8"?>
<!--
  AnonGee . CAD to BIM - finished.

  What the run cost, after it is over. One number, big: the time the tool spent building,
  which is the tool's own time and the only figure it is fair to be judged on. The parts are
  underneath in caption size - the time spent in dialogs is the person's, and the time from
  the click is both.

  The root element carries literal values only (12.7.A).
-->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CAD to BIM - finished"
        Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="White"
        UseLayoutRounding="True"
        FontFamily="Segoe UI, Inter, Calibri, Arial">

  <Window.Resources>
    <!-- ANONGEE-THEME -->
  </Window.Resources>

  <DockPanel LastChildFill="True">

    <Border DockPanel.Dock="Bottom" Background="{StaticResource BrushOffWhite}"
            BorderBrush="{StaticResource BrushLightBorder}" BorderThickness="0,1,0,0"
            Padding="16,8">
      <Grid>
        <TextBlock x:Name="CountdownText" VerticalAlignment="Center"
                   Style="{StaticResource TextCaption}" HorizontalAlignment="Left"/>
        <Button x:Name="BtnClose" Content="Close" Style="{StaticResource ButtonPrimary}"
                Width="110" HorizontalAlignment="Right" IsDefault="True" IsCancel="True"/>
      </Grid>
    </Border>

    <StackPanel Margin="24,20,24,18">
      <TextBlock x:Name="HeadlineText" Text="Model prepared" Style="{StaticResource TextH3}"
                 Margin="0,0,0,2"/>

      <!-- The one thing on this window. -->
      <TextBlock x:Name="ElapsedText" Text="-" Style="{StaticResource TextFigure}"
                 TextAlignment="Left" Margin="0,2,0,2"/>

      <TextBlock x:Name="ElapsedCaption" Text="preparing the model"
                 Style="{StaticResource TextCaption}" Margin="0,0,0,6"/>

      <WrapPanel Margin="0,2,0,0">
        <TextBlock Text="in the dialogs" Style="{StaticResource TextCaption}" VerticalAlignment="Center"/>
        <TextBlock x:Name="WaitingText" Text="-" Style="{StaticResource TextFigureSmall}"
                   VerticalAlignment="Center" Margin="6,0,0,0"/>
        <TextBlock Text="  &#183;  from the click" Style="{StaticResource TextCaption}"
                   VerticalAlignment="Center" Margin="6,0,0,0"/>
        <TextBlock x:Name="TotalText" Text="-" Style="{StaticResource TextFigureSmall}"
                   VerticalAlignment="Center" Margin="6,0,0,0"/>
      </WrapPanel>

      <TextBlock x:Name="BreakdownText" Style="{StaticResource TextCaption}"
                 TextWrapping="Wrap" Margin="0,6,0,0"/>
    </StackPanel>
  </DockPanel>
</Window>
