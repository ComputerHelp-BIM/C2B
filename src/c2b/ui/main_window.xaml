<?xml version="1.0" encoding="utf-8"?>
<!--
  AnonGee . CAD to BIM  -  the C2B window.

  Markup lives in this file rather than in a Python string (brand guide 12.2). The theme is
  spliced over the ANONGEE-THEME line at load time, generated from c2b/ui/theme.py.

  The root element carries literal values only - never a resource reference - because
  XamlReader resolves a window's own attributes before its Resources block is parsed (12.7.A).

  The shape is the suite's, the same as One Filter Parameter and the Storey Editor: an outer
  grid inset from the frame, a Charcoal header with rounded top corners and a version badge,
  the 3px accent rule, the body, a status bar card, an action bar. The header's right-hand
  slot carries the identity over the version badge, the same as every other C2B window.

  The file rows are built in Python from c2b.gui.session.FIELDS, so the same five rows serve
  this window and the Tkinter fallback and cannot drift apart.
-->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AnonGee &#183; CAD to BIM"
        Width="1240" Height="900" MinWidth="1040" MinHeight="660"
        Background="White"
        UseLayoutRounding="True"
        FontFamily="Segoe UI, Inter, Calibri, Arial"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        ShowInTaskbar="True">

  <Window.Resources>
    <!-- ANONGEE-THEME -->
  </Window.Resources>

  <Grid Margin="12,8">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>   <!-- 0 header -->
      <RowDefinition Height="3"/>      <!-- 1 accent rule -->
      <RowDefinition Height="Auto"/>   <!-- 2 the job -->
      <RowDefinition Height="*"/>      <!-- 3 progress and things to check -->
      <RowDefinition Height="Auto"/>   <!-- 4 what to do next -->
      <RowDefinition Height="Auto"/>   <!-- 5 status bar -->
      <RowDefinition Height="Auto"/>   <!-- 6 action bar -->
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="{StaticResource BrushCharcoalBlack}"
            Padding="16,12" CornerRadius="5,5,0,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0">
          <TextBlock Style="{StaticResource TextH2OnDark}" Text="CAD to BIM"/>
          <TextBlock Style="{StaticResource TextH3OnDark}" Margin="0,2,0,0" TextWrapping="Wrap"
                     Text="A client drawing, redrawn in the firm's template and prepared for Revit."/>
        </StackPanel>
        <StackPanel Grid.Column="1" VerticalAlignment="Top" HorizontalAlignment="Right">
          <TextBlock Style="{StaticResource TextCaption}" HorizontalAlignment="Right"
                     Foreground="{StaticResource BrushSilverSteel}" Text="AnonGee &#183; CAD to BIM"/>
          <TextBlock x:Name="VersionBadge" Style="{StaticResource TextBadge}" Margin="0,2,0,0"
                     HorizontalAlignment="Right"
                     Foreground="{StaticResource BrushSilverSteel}" Text="v0"/>
        </StackPanel>
      </Grid>
    </Border>

    <Rectangle Grid.Row="1" Fill="{StaticResource BrushVividRed}"/>

    <!-- The job: what to read, and how to read it. -->
    <StackPanel Grid.Row="2" Margin="0,10,0,0">
      <!-- The five file rows are added here from c2b.gui.session.FIELDS. -->
      <Grid x:Name="FieldsHost">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" MinWidth="136"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
      </Grid>

      <Rectangle Style="{StaticResource DividerRule}" Margin="0,10,0,10"/>

      <!-- The option boxes are added here the same way. -->
      <WrapPanel x:Name="OptionsHost"/>

      <!-- A beam or a slab the drawing never sizes cannot go into Revit without one, and
           dropping it loses the member. Typed once, remembered, and the run says how many
           used it. -->
      <WrapPanel Margin="0,8,0,0">
        <TextBlock Style="{StaticResource TextCaption}" Margin="0,0,8,0"
                   Text="When the drawing gives no size  -  beam depth"/>
        <TextBox x:Name="BeamDepth" Style="{StaticResource InputNumberBox}" Width="84" Margin="0,0,4,0"/>
        <TextBlock Style="{StaticResource TextCaption}" Text="mm"/>
        <TextBlock Style="{StaticResource TextCaption}" Margin="20,0,8,0" Text="slab thickness"/>
        <TextBox x:Name="SlabThickness" Style="{StaticResource InputNumberBox}" Width="84" Margin="0,0,4,0"/>
        <TextBlock Style="{StaticResource TextCaption}" Text="mm"/>
        <TextBlock Style="{StaticResource TextCaption}" Margin="20,0,0,0"
                   Text="leave empty to leave those members out of the Revit model"/>
      </WrapPanel>

      <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
        <Button x:Name="BtnRun" Style="{StaticResource ButtonPrimary}" Content="_Run"
                Width="156" Height="41"/>
        <Button x:Name="BtnVerify" Style="{StaticResource ButtonNeutral}"
                Content="Re-check an edited template DXF" Width="276" Height="41" Margin="8,0,0,0"/>
      </StackPanel>

      <!-- Determinate where the size is known: four steps, counted (11.2). -->
      <ProgressBar x:Name="Progress" Style="{StaticResource ProgressBarStyle}"
                   Minimum="0" Maximum="4" Value="0" Margin="0,12,0,0"/>
    </StackPanel>

    <!-- Progress and the things to check, sharing what is left. -->
    <Grid Grid.Row="3" Margin="0,10,0,0">
      <Grid.RowDefinitions>
        <RowDefinition Height="3*" MinHeight="156"/>
        <RowDefinition Height="8"/>
        <RowDefinition Height="2*" MinHeight="124"/>
      </Grid.RowDefinitions>

      <Border Grid.Row="0" Style="{StaticResource CardBorder}" Padding="0">
        <DockPanel>
          <Border DockPanel.Dock="Top" Background="{StaticResource BrushOffWhite}"
                  BorderBrush="{StaticResource BrushLightBorder}" BorderThickness="0,0,0,1"
                  CornerRadius="7,7,0,0" Padding="10,5">
            <TextBlock Style="{StaticResource TextBadge}"
                       Foreground="{StaticResource BrushMidGrey}" Text="PROGRESS"/>
          </Border>
          <ScrollViewer x:Name="LogScroller" VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled" Margin="10,6,4,8">
            <StackPanel x:Name="LogHost"/>
          </ScrollViewer>
        </DockPanel>
      </Border>

      <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="0">
        <DockPanel>
          <Border DockPanel.Dock="Top" Background="{StaticResource BrushTableHeaderBackground}"
                  CornerRadius="7,7,0,0">
            <Grid Margin="0,6">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="112"/>
                <ColumnDefinition Width="98"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Style="{StaticResource TextBadge}" Margin="10,0,0,0"
                         Foreground="{StaticResource BrushPureWhite}" Text="THINGS TO CHECK"/>
              <TextBlock Grid.Column="1" Style="{StaticResource TextBadge}"
                         HorizontalAlignment="Center"
                         Foreground="{StaticResource BrushPureWhite}" Text="HOW MANY"/>
              <TextBlock Grid.Column="2" Style="{StaticResource TextBadge}" Margin="10,0,0,0"
                         Foreground="{StaticResource BrushPureWhite}" Text="WHAT IT MEANS"/>
            </Grid>
          </Border>
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="IssuesHost"/>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Grid>

    <!-- A drafter reading a log of forty lines cannot tell which one is addressed to them,
         so the single thing to do next gets a line of its own. -->
    <Grid Grid.Row="4" x:Name="NextRow" Margin="0,10,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <TextBlock x:Name="NextLabel" Grid.Column="0" Style="{StaticResource FieldLabel}"
                 TextWrapping="Wrap" Text=""/>
      <Button x:Name="BtnStoreys" Grid.Column="1" Style="{StaticResource ButtonSecondary}"
              Content="_Storeys…" Width="144" Visibility="Collapsed"/>
    </Grid>

    <Border Grid.Row="5" Background="{StaticResource BrushOffWhite}"
            BorderBrush="{StaticResource BrushLightBorder}" BorderThickness="1"
            Padding="12,7" Margin="0,8,0,0" CornerRadius="5">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border x:Name="StatusBadgeBorder" Grid.Column="0" Style="{StaticResource BadgeBorder}"
                Background="{StaticResource BrushInfoBadgeBackground}">
          <TextBlock x:Name="StatusBadge" Style="{StaticResource TextBadge}"
                     Foreground="{StaticResource BrushInfoBadgeForeground}" Text="READY"/>
        </Border>
        <TextBlock x:Name="StatusLine" Grid.Column="1" Style="{StaticResource TextCaption}"
                   Margin="10,0,0,0" TextTrimming="CharacterEllipsis"
                   Text="Pick a client drawing and press Run."/>
      </Grid>
    </Border>

    <!-- What a finished run left behind. -->
    <Border Grid.Row="6" Background="{StaticResource BrushOffWhite}"
            BorderBrush="{StaticResource BrushLightBorder}" BorderThickness="0,1,0,0"
            Padding="12,8" Margin="0,8,0,0">
      <WrapPanel x:Name="ActionsHost"/>
    </Border>

  </Grid>
</Window>
