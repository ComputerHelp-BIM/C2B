<?xml version="1.0" encoding="utf-8"?>
<!--
  AnonGee . Storey Editor  -  the storeys of the building, and how far apart they are.

  Markup lives in this file rather than in a Python string (brand guide 12.2). The theme is
  spliced over the ANONGEE-THEME line at load time, generated from c2b/ui/theme.py, so the
  inline copy 12.3 asks for cannot drift from the tokens it came from.

  The root element carries literal values only - never a resource reference - because
  XamlReader resolves a window's own attributes before its Resources block is parsed (12.7.A).

  THE SHAPE IS THE SUITE'S, and it is the same five parts in the same order in every C2B
  window: an inset frame, a Charcoal header with rounded top corners carrying the title, the
  subtitle and the identity, a 3px accent rule, the body, and an Off White footer.

  EVERY CHILD OF A DOCKPANEL BUT THE LAST DECLARES ITS DOCK. DockPanel.Dock defaults to Left,
  silently: the instruction panel below had no Dock for a release, took the whole width as a
  left column because a wrapping TextBlock measures unwrapped when it is given infinite width,
  and left the table nothing to fill. The window opened with no table on it at all.

  The table is a real DataGrid, laid out like the Multi-storey page of cad2bim. Columns are
  resizable. The buttons under it act on the row the user clicked, which is what selection
  means here and the only thing it means: the Build tick is the storey's own value, read one
  way and written back through the tick's Checked event (12.7.Q).
-->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AnonGee &#183; Storey Editor"
        Width="1120" Height="880" MinWidth="980" MinHeight="600"
        Background="White"
        UseLayoutRounding="True"
        FontFamily="Segoe UI, Inter, Calibri, Arial"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="True">

  <Window.Resources>
    <!-- ANONGEE-THEME -->
  </Window.Resources>

  <DockPanel Margin="12,8" LastChildFill="True" Background="{StaticResource BrushPureWhite}">

    <!-- 1  The header: what this window is, and whose it is. -->
    <Border DockPanel.Dock="Top" Background="{StaticResource BrushCharcoalBlack}"
            Padding="16,12" CornerRadius="5,5,0,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0">
          <TextBlock Style="{StaticResource TextH2OnDark}" Text="Storey Editor"/>
          <!-- Filled from the run, so it is a sentence of unknown length and must wrap: the
               subtitle style does not, and a clipped sentence is worse than a wrapped one. -->
          <TextBlock x:Name="HeaderSubtitle" Style="{StaticResource TextH3OnDark}" Margin="0,2,0,0"
                     TextWrapping="Wrap"
                     Text="The storeys of the building, and how far apart they are."/>
        </StackPanel>
        <StackPanel Grid.Column="1" VerticalAlignment="Top" HorizontalAlignment="Right">
          <TextBlock Style="{StaticResource TextCaption}" HorizontalAlignment="Right"
                     Foreground="{StaticResource BrushSilverSteel}" Text="AnonGee &#183; CAD to BIM"/>
          <TextBlock x:Name="VersionBadge" Style="{StaticResource TextBadge}" Margin="0,2,0,0"
                     HorizontalAlignment="Right"
                     Foreground="{StaticResource BrushSilverSteel}" Text="v0"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- 2  The accent rule. -->
    <Rectangle DockPanel.Dock="Top" Height="3" Fill="{StaticResource BrushVividRed}"/>

    <!-- 5  The footer: where it stands on the left, what to do about it on the right (12.6). -->
    <Border DockPanel.Dock="Bottom" Background="{StaticResource BrushOffWhite}"
            BorderBrush="{StaticResource BrushLightBorder}" BorderThickness="0,1,0,0"
            Padding="12,8">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Border x:Name="StatusBadgeBorder" Grid.Column="0" Style="{StaticResource BadgeBorder}"
                Background="{StaticResource BrushInfoBadgeBackground}">
          <TextBlock x:Name="StatusBadge" Style="{StaticResource TextBadge}"
                     Foreground="{StaticResource BrushInfoBadgeForeground}" Text="READY"/>
        </Border>
        <TextBlock x:Name="StatusLine" Grid.Column="1" Style="{StaticResource TextCaption}"
                   Margin="10,0,8,0" VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" Text=""/>
        <Button x:Name="BtnCancel" Grid.Column="2" Content="Cancel"
                Style="{StaticResource ButtonGhost}" Width="100" IsCancel="True"/>
        <Button x:Name="BtnSave" Grid.Column="3" Content="Save the storeys"
                Style="{StaticResource ButtonPrimary}" Width="184" Margin="8,0,0,0" IsDefault="True"/>
      </Grid>
    </Border>

    <!-- 4  Problems: inline, above the footer, never a modal box (11.5, 13.4). -->
    <Border x:Name="ProblemsPanel" DockPanel.Dock="Bottom" Visibility="Collapsed"
            Background="{StaticResource BrushPureWhite}"
            BorderBrush="{StaticResource BrushLightBorder}" BorderThickness="0,1,0,0">
      <ScrollViewer MaxHeight="112" VerticalScrollBarVisibility="Auto" Margin="12,8">
        <StackPanel x:Name="ProblemsHost"/>
      </ScrollViewer>
    </Border>

    <!-- 3a  How to read the table. -->
    <StackPanel DockPanel.Dock="Top" Margin="0,10,0,8">
      <TextBlock Style="{StaticResource HelpText}"
                 Text="One row per storey, BOTTOM-UP: the first row is built first, on the base elevation. Built from is which detected floor plan that storey uses -- pick the same plan on several rows, or set Repeat to build one plan more than once. Height is that storey's floor-to-floor rise; type a height or an elevation and the other follows. Untick Build to leave a storey out. Click a row, then use the buttons under the table to move, add or remove it."/>
      <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
        <TextBlock Text="New storeys are" Style="{StaticResource TextLabel}" VerticalAlignment="Center"/>
        <TextBox x:Name="DefaultHeight" Style="{StaticResource InputNumberBox}"
                 Width="92" Margin="8,0,6,0" Text="3000"/>
        <TextBlock Text="mm tall" Style="{StaticResource TextLabel}" VerticalAlignment="Center"/>
      </StackPanel>
    </StackPanel>

    <!-- 3b  The table itself, filling whatever is left. -->
    <Border Style="{StaticResource CardBorder}" Padding="0" Margin="0,0,0,10">
      <DockPanel LastChildFill="True">

        <Border DockPanel.Dock="Bottom" Background="{StaticResource BrushOffWhite}"
                BorderBrush="{StaticResource BrushLightBorder}" BorderThickness="0,1,0,0"
                CornerRadius="0,0,7,7" Padding="10,6">
          <StackPanel Orientation="Horizontal">
            <Button x:Name="BtnUp" Content="Move up" Style="{StaticResource ButtonNeutral}" Width="108"/>
            <Button x:Name="BtnDown" Content="Move down" Style="{StaticResource ButtonNeutral}"
                    Width="124" Margin="8,0,0,0"/>
            <Button x:Name="BtnAdd" Content="Add storey" Style="{StaticResource ButtonNeutral}"
                    Width="124" Margin="8,0,0,0"/>
            <Button x:Name="BtnAddBottom" Content="Add at the bottom"
                    Style="{StaticResource ButtonNeutral}" Width="172" Margin="8,0,0,0"/>
            <Button x:Name="BtnRemove" Content="Remove" Style="{StaticResource ButtonNeutral}"
                    Width="108" Margin="8,0,0,0"/>
            <TextBlock x:Name="SelectionText" Style="{StaticResource TextCaption}"
                       VerticalAlignment="Center" Margin="12,0,0,0"/>
          </StackPanel>
        </Border>

        <DataGrid x:Name="StoreyGrid" Style="{StaticResource DataGridStyle}">
          <DataGrid.Resources>
            <!-- 12.7.H: the DataGrid's visual state manager paints a selected row with the
                 system highlight unless these keys are redefined at its own scope. -->
            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#FEF2F2"/>
            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#141414"/>
            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#FEF2F2"/>
            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#141414"/>
          </DataGrid.Resources>
          <DataGrid.Columns>

            <DataGridTemplateColumn Header="Build" Width="62" CanUserResize="False" IsReadOnly="True">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <!-- Tag names this tick for the grid-wide Checked handler: a ComboBox raises
                       the same routed event from the ToggleButton inside its own template. -->
                  <CheckBox Style="{StaticResource GridCheckBox}" Tag="BuildTick"
                            IsChecked="{Binding Build, Mode=OneWay}"/>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <DataGridTextColumn Header="No." Binding="{Binding Number}" Width="52" IsReadOnly="True"
                                ElementStyle="{StaticResource GridMuted}"/>

            <DataGridTextColumn Header="Storey" Binding="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                Width="*" MinWidth="170"
                                ElementStyle="{StaticResource GridText}"
                                EditingElementStyle="{StaticResource GridEditBox}"/>

            <DataGridTextColumn Header="Height mm" Binding="{Binding Height, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                Width="110"
                                ElementStyle="{StaticResource GridNumber}"
                                EditingElementStyle="{StaticResource GridEditNumberBox}"/>

            <DataGridTextColumn Header="Elevation mm" Binding="{Binding Elevation, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                Width="126"
                                ElementStyle="{StaticResource GridNumber}"
                                EditingElementStyle="{StaticResource GridEditNumberBox}"/>

            <DataGridTemplateColumn Header="Built from" Width="220" IsReadOnly="True">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <ComboBox Style="{StaticResource GridComboBox}"
                            ItemsSource="{Binding PlanChoices}"
                            SelectedItem="{Binding Plan, Mode=TwoWay}"/>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <DataGridTextColumn Header="Repeat" Binding="{Binding Repeat, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                Width="78"
                                ElementStyle="{StaticResource GridNumber}"
                                EditingElementStyle="{StaticResource GridEditNumberBox}"/>

            <DataGridTextColumn Header="Note" Binding="{Binding Flag}" Width="118" IsReadOnly="True"
                                ElementStyle="{StaticResource GridMuted}"/>
          </DataGrid.Columns>
        </DataGrid>

      </DockPanel>
    </Border>

  </DockPanel>
</Window>
