<?xml version="1.0" encoding="utf-8"?>
<!--
  AnonGee . Storey Editor  -  the storeys of the building, and how far apart they are.

  Markup lives in this file rather than in a Python string (brand guide 12.2). The theme is
  spliced over the ANONGEE-THEME line at load time, generated from c2b/ui/theme.py, so the
  inline copy 12.3 asks for cannot drift from the tokens it came from.

  The root element carries literal values only - never a resource reference - because
  XamlReader resolves a window's own attributes before its Resources block is parsed (12.7.A).

  The shape is the suite's: an outer grid inset from the frame, a Charcoal header with rounded
  top corners, the 3px accent rule, the body, a status bar card, an action bar. Same rows, same
  paddings and same order as One Filter Parameter, so the two windows read as one tool.

  The rows are built in Python and added to RowsHost, styled to look like the suite's DataGrid.
  A DataGrid's text columns bind fine, but these cells are edited, and 12.7.G/J/Q are all ways
  a two-way binding to a Python object fails under pythonnet. Reading a TextBox's .Text has
  none of them, and a building has a dozen storeys, not ten thousand.

  Each row carries its own buttons. A toolbar that acts on "the selected storey" needs the user
  to know which one that is, and nothing on screen says so.
-->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AnonGee &#183; Storey Editor"
        Width="980" MinWidth="880"
        SizeToContent="Height" MaxHeight="860"
        Background="White"
        UseLayoutRounding="True"
        FontFamily="JetBrains Mono, Source Serif 4, Inter, Segoe UI, Calibri"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="True">

  <Window.Resources>
    <!-- ANONGEE-THEME -->
  </Window.Resources>

  <Grid Margin="12,8">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>   <!-- 0 header -->
      <RowDefinition Height="3"/>      <!-- 1 accent rule -->
      <RowDefinition Height="Auto"/>   <!-- 2 toolbar -->
      <RowDefinition Height="*"/>      <!-- 3 the stack -->
      <RowDefinition Height="Auto"/>   <!-- 4 problems -->
      <RowDefinition Height="Auto"/>   <!-- 5 status bar -->
      <RowDefinition Height="Auto"/>   <!-- 6 action bar -->
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="{StaticResource BrushCharcoalBlack}"
            Padding="16,12" CornerRadius="5,5,0,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0">
          <TextBlock Style="{StaticResource TextH2OnDark}" Text="Storey Editor"/>
          <TextBlock x:Name="HeaderSubtitle" Style="{StaticResource TextH3OnDark}"
                     Margin="0,2,0,0" TextWrapping="Wrap"
                     Text="The storeys of the building, and how far apart they are."/>
        </StackPanel>
        <TextBlock Grid.Column="1" Style="{StaticResource TextBadge}" VerticalAlignment="Top"
                   Foreground="{StaticResource BrushSilverSteel}" Text="AnonGee &#183; C2B"/>
      </Grid>
    </Border>

    <Rectangle Grid.Row="1" Fill="{StaticResource BrushVividRed}"/>

    <!-- Toolbar: only what is not about one particular storey. -->
    <Grid Grid.Row="2" Margin="0,10,0,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0" Orientation="Horizontal">
        <Button x:Name="BtnAdd" Style="{StaticResource ButtonSecondary}" Content="_Add on top"
                Width="120" Margin="0,0,8,0"/>
        <Button x:Name="BtnAddBottom" Style="{StaticResource ButtonNeutral}"
                Content="Add at the _bottom" Width="150"/>
      </StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock Style="{StaticResource TextCaption}" Margin="0,0,6,0" Text="New storeys are"/>
        <TextBox x:Name="DefaultHeight" Style="{StaticResource InputNumberBox}" Width="64" Text="3000"/>
        <TextBlock Style="{StaticResource TextCaption}" Margin="6,0,0,0" Text="mm tall"/>
      </StackPanel>
    </Grid>

    <!-- The stack, as a card with a Charcoal column header and its own footer. -->
    <Border Grid.Row="3" Style="{StaticResource CardBorder}" Padding="0">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource BrushTableHeaderBackground}"
                CornerRadius="7,7,0,0">
          <Grid x:Name="HeaderRow" Margin="0,6">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="30"/>
              <ColumnDefinition Width="*"  MinWidth="150"/>
              <ColumnDefinition Width="82"/>
              <ColumnDefinition Width="92"/>
              <ColumnDefinition Width="168"/>
              <ColumnDefinition Width="86"/>
              <ColumnDefinition Width="188"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Style="{StaticResource TextBadge}" Margin="8,0,0,0"
                       Foreground="{StaticResource BrushPureWhite}" Text="#"/>
            <TextBlock Grid.Column="1" Style="{StaticResource TextBadge}" Margin="8,0,0,0"
                       Foreground="{StaticResource BrushPureWhite}" Text="STOREY"/>
            <TextBlock Grid.Column="2" Style="{StaticResource TextBadge}" Margin="0,0,8,0"
                       HorizontalAlignment="Right"
                       Foreground="{StaticResource BrushPureWhite}" Text="HEIGHT"/>
            <TextBlock Grid.Column="3" Style="{StaticResource TextBadge}" Margin="0,0,8,0"
                       HorizontalAlignment="Right"
                       Foreground="{StaticResource BrushPureWhite}" Text="ELEVATION"/>
            <TextBlock Grid.Column="4" Style="{StaticResource TextBadge}" Margin="8,0,0,0"
                       Foreground="{StaticResource BrushPureWhite}" Text="BUILT FROM"/>
            <TextBlock Grid.Column="5" Style="{StaticResource TextBadge}" Margin="8,0,0,0"
                       Foreground="{StaticResource BrushPureWhite}" Text="NOTE"/>
            <TextBlock Grid.Column="6" Style="{StaticResource TextBadge}" Margin="8,0,0,0"
                       Foreground="{StaticResource BrushPureWhite}" Text="THIS STOREY"/>
          </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
          <StackPanel x:Name="RowsHost"/>
        </ScrollViewer>

        <Border Grid.Row="2" Background="{StaticResource BrushOffWhite}"
                BorderBrush="{StaticResource BrushLightBorder}" BorderThickness="0,1,0,0"
                CornerRadius="0,0,7,7" Padding="10,5">
          <TextBlock Style="{StaticResource TextCaption}"
                     Text="Every storey rises from the one below it. Type a height or an elevation and the other follows. Repeat a storey to build one drawn plan more than once."/>
        </Border>
      </Grid>
    </Border>

    <!-- Problems: inline, above the status bar, never a modal box (11.5, 13.4). -->
    <Border x:Name="ProblemsPanel" Grid.Row="4" Visibility="Collapsed"
            Style="{StaticResource CardBorder}" Padding="12,8" Margin="0,8,0,0">
      <ScrollViewer MaxHeight="92" VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="ProblemsHost"/>
      </ScrollViewer>
    </Border>

    <Border Grid.Row="5" Background="{StaticResource BrushOffWhite}"
            BorderBrush="{StaticResource BrushLightBorder}" BorderThickness="1"
            Padding="12,7" Margin="0,8,0,0" CornerRadius="5">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border x:Name="StatusBadgeBorder" Grid.Column="0" Style="{StaticResource BadgeBorder}"
                Background="{StaticResource BrushInfoBadgeBackground}">
          <TextBlock x:Name="StatusBadge" Style="{StaticResource TextBadge}"
                     Foreground="{StaticResource BrushInfoBadgeForeground}" Text="READY"/>
        </Border>
        <TextBlock x:Name="StatusLine" Grid.Column="1" Style="{StaticResource TextCaption}"
                   Margin="10,0,0,0" Text=""/>
      </Grid>
    </Border>

    <Border Grid.Row="6" Background="{StaticResource BrushOffWhite}"
            BorderBrush="{StaticResource BrushLightBorder}" BorderThickness="0,1,0,0"
            Padding="12,8" Margin="0,8,0,0">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="BtnCancel" Style="{StaticResource ButtonGhost}" Content="Cancel"
                Width="100" IsCancel="True"/>
        <Button x:Name="BtnSave" Style="{StaticResource ButtonPrimary}" Content="_Save the storeys"
                Width="160" Margin="10,0,0,0" IsDefault="True"/>
      </StackPanel>
    </Border>

  </Grid>
</Window>
